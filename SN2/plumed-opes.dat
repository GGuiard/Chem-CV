UNITS LENGTH=A ENERGY=eV

d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=1,6
dd: MATHEVAL ARG=d1,d2 FUNC=x-y PERIODIC=NO

UPPER_WALLS ARG=d1 AT=4 KAPPA=1 EXP=2 EPS=0.1
UPPER_WALLS ARG=d2 AT=4 KAPPA=1 EXP=2 EPS=0.1

opes: OPES_METAD_EXPLORE ARG=dd PACE=100 BARRIER=1 TEMP=300 STATE_WFILE=STATES STATE_WSTRIDE=10*100

PRINT STRIDE=1 ARG=dd,d1,d2,opes.* FILE=COLVAR
FLUSH STRIDE=1000