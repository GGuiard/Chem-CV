UNITS LENGTH=A

LOAD FILE=../PytorchModelGNN.cpp

PYTORCH_GNN ...
  SYSTEM_SELECTION=2,6
  ENVIRONMENT_SELECTION=1,3,4,5
  MODEL=model.ptc
  STRUCTURE=../traj_top.pdb
  NL_STRIDE=1
  CUDA
  LABEL=chemcv
... PYTORCH_GNN

PRINT STRIDE=1 ARG=chemcv.node-0 FILE=CHEMCV_value
DUMPDERIVATIVES ARG=chemcv.node-0 STRIDE=1 FILE=CHEMCV_derivative